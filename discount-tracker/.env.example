# Bu dosyayı .env olarak kopyalayıp doldurun. .env commit'lenmez; değerleri kimseyle paylaşmayın.
CREATORS_CLIENT_ID=
CREATORS_CLIENT_SECRET=
# Associates Central'da kimlik bilgisinin yanında görünen sürüm (örn. 3.2)
CREATORS_CREDENTIAL_VERSION=
# amazon.com.tr takip kimliği, örn. xxxx-21
CREATORS_PARTNER_TAG=
# İlk çalıştırmadan sonra, sayfasında satıcısı Amazon.com.tr olan bir üründen doğrulanarak doldurulur
AMAZON_TR_MERCHANT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
